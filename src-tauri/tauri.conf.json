{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Una Eademque Essentia",
  "version": "0.2.0",
  "identifier": "com.unaeademqueessentia.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{
      "title": "Una Eademque Essentia",
      "width": 1100,
      "height": 760,
      "resizable": true,
      "fullscreen": false,
      "minWidth": 760,
      "minHeight": 600,
      "center": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}